# Copy to .env. docker-compose reads it.
GOOGLE_CLOUD_API_KEY=

# Concurrency/resource tuning — every var below has a default baked into
# docker-compose.yml sized for a 2 vCPU / 8GB VM (see that file's comments
# for the arithmetic behind each number). Uncomment and change only when
# moving to a differently-sized box, or after confirming your GenAI key's
# quota tier actually supports more concurrent model calls than the default.
# WORKER_CONCURRENCY=12
# TUTOR_CONCURRENCY=4
# CHECK_CONCURRENCY=2
